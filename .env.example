# SQLite remains the default provider.
DB_CLIENT=sqlite
DB_PATH=\\PC-SERVER\Database\database.db

# PostgreSQL: set DB_CLIENT=postgres and configure either DATABASE_URL or PG* values.
# DATABASE_URL=postgresql://mainproject_app:CHANGE_ME@PC-SERVER:5432/mainproject
PGHOST=PC-SERVER
PGPORT=5432
PGDATABASE=mainproject
PGUSER=mainproject_app
PGPASSWORD=CHANGE_ME

# Used only by the migration command when it differs from DB_PATH.
SQLITE_SOURCE_PATH=\\PC-SERVER\Database\database.db
PG_BACKUP_DIR=C:\DatabaseBackups